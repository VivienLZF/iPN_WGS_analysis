#!/bin/bash
##############################################################################

## QC by sequencing batch: remove variant loci with >0.1 missing call rate in each batch
## Usage: bash 2_filter_loci_by_batch.sh $chr
## Docker: staphb/bcftools:latest

##############################################################################

nthreads=$(nproc)
batches=(
    "1.txt"
    "2.txt"
    "3.txt"
    "4.txt"
)
names=()
for f in "${batches[@]}"; do
  names+=("$(cut -d '.' -f 1 <<< "$(basename "$f")")")
done
chr=$(echo $1)
input_file="VCFs/chr${chr}/chr${chr}_IPN_QC_all.vcf.gz"
sample=${batches[${LSB_JOBINDEX} - 1]}
sample_name=${names[${LSB_JOBINDEX} - 1]}
output="VCFs/chr${chr}/chr${chr}_IPN_batchQC_${sample_name}.vcf.gz"

bcftools view --threads ${nthreads} -S ${sample} ${input_file} | \
bcftools filter -e 'F_MISSING>0.1' -Wtbi -Oz -o ${output}